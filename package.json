{
  "name": "edgarcnp-homebrew-tap-packaging",
  "private": true,
  "type": "module",
  "description": "Build tooling for the AppImage casks in this tap. Node's native type stripping runs the TypeScript directly; no build step, no runtime dependencies.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "fbr": "node packaging/bin/fbr.ts",
    "test": "node --test \"packaging/tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint:shell": "find packaging -name '*.sh' -print0 | xargs -0 shellcheck",
    "style": "brew style edgarcnp/tap"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
