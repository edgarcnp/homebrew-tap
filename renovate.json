{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":disableDependencyDashboard"
  ],
  "abandonmentThreshold": "1 year",
  "addLabels": [
    "renovate",
    "dependencies"
  ],
  "automerge": false,
  "keepUpdatedLabel": "renovate-keep-updated",
  "lockFileMaintenance": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": true,
  "pruneBranchAfterAutomerge": true,
  "reviewers": [
    "edgarcnp"
  ],
  "rollbackPrs": true,
  "schedule": [
    "* * * * *"
  ],
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "rangeStrategy": "bump",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest"
  },
  "customManagers": [
    {
      "description": "actionlint release pinned by hand in the lint step of the test workflow",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/tests\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rhysd/actionlint",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "pkgforge appimagetool release pinned in the builder Dockerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packaging\\/builder\\/Dockerfile$/"
      ],
      "matchStrings": [
        "appimagetool/releases/download/(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pkgforge-dev/appimagetool"
    },
    {
      "description": "Node version baked into the builder Dockerfile, kept in step with the runtime pin",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packaging\\/builder\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    },
    {
      "description": "quick-sharun and get-debloated-pkgs, pinned to a commit of Anylinux-AppImages",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packaging\\/scripts\\/install-anylinux-tools\\.sh$/"
      ],
      "matchStrings": [
        "PINNED_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "pkgforge-dev/Anylinux-AppImages",
      "packageNameTemplate": "https://github.com/pkgforge-dev/Anylinux-AppImages",
      "datasourceTemplate": "git-refs"
    },
    {
      "description": "brew container image nested in the tests workflow strategy matrix, which the github-actions manager cannot see (it only reads a job-level container:)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/tests\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/homebrew/brew:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "depNameTemplate": "ghcr.io/homebrew/brew",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Versioned runner labels assembled into the AppImage build matrix by jq, where runs-on: reads an expression the github-actions manager ignores",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-appimage\\.yml$/"
      ],
      "matchStrings": [
        "runner: \"ubuntu-(?<currentValue>[0-9]+(?:\\.[0-9]+)+(?:-arm)?)\""
      ],
      "datasourceTemplate": "github-runners",
      "depNameTemplate": "ubuntu runner",
      "packageNameTemplate": "ubuntu"
    },
    {
      "description": "Homebrew/actions tags are bare CalVer (YYYY.MM.DD.N); the github-actions manager parses only three version components and its versioning rejects the zero-padded tags, so read the full tag from the pin comment",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>Homebrew/actions/[\\w-]+)@(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "Homebrew/actions",
      "versioningTemplate": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})\\.(?<build>\\d+)$",
      "autoReplaceStringTemplate": "{{depName}}@{{newDigest}} # {{newValue}}"
    }
  ],
  "packageRules": [
    {
      "description": "TypeScript stays on the 6.x line until this toolchain is ready for 7",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": ">=6.0.3 <7"
    },
    {
      "description": "@types/node describes the Node the CI runs, so it stays on the runtime's major line",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": ">=24 <25"
    },
    {
      "description": "Actions are SHA-pinned; one PR per digest bump keeps the review small",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Homebrew/actions CalVer pins are extracted by the regex customManager above; the github-actions manager only sees a truncated tag and warns that it cannot determine a digest",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "Homebrew/actions"
      ],
      "enabled": false
    },
    {
      "description": "Homebrew/actions CalVer pins come from the regex customManager above; keep them in the GitHub Actions PR with the rest of the action updates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "Homebrew/actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The tests workflow brew image is extracted by the regex customManager above; keep both brew digests in the GitHub Actions PR so the two files move together",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ghcr.io/homebrew/brew"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The Node runtime pins (engines, setup-node, the builder Dockerfile) and @types/node are reviewed on their own",
      "matchDatasources": [
        "node-version",
        "github-releases",
        "npm"
      ],
      "matchPackageNames": [
        "node",
        "actions/node-versions",
        "@types/node"
      ],
      "groupName": "node runtime"
    },
    {
      "description": "pnpm is pinned in packageManager and the workflow action, so both move in one PR",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "pnpm"
      ],
      "groupName": "pnpm"
    },
    {
      "description": "The builder image is pinned by the builder workflow's pin job, not Renovate",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/edgarcnp/fbr-builder-base"
      ],
      "enabled": false
    },
    {
      "description": "Hand-pinned upstream tools whose version is addressed by a URL Renovate rewrites",
      "matchPackageNames": [
        "rhysd/actionlint",
        "pkgforge-dev/appimagetool",
        "pkgforge-dev/Anylinux-AppImages"
      ],
      "groupName": "pinned upstream build tools",
      "prBodyNotes": [
        "No dependency in this group carries a local SHA-256: actionlint and pkgforge-dev/appimagetool are downloaded from a URL addressed by the version Renovate bumps, so no pin needs updating in this PR. pkgforge-dev/Anylinux-AppImages needs no such update either: its tools are fetched from a URL addressed by the commit digest Renovate bumps."
      ]
    }
  ]
}
