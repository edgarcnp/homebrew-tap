#!/bin/bash
set -euo pipefail

# shellcheck source=../../lib/apprun-common.sh
__src="${BASH_SOURCE[0]}"
[[ "${__src}" = /* ]] || __src="${PWD}/${__src}"
[[ -L "${__src}" ]] && __src="$(readlink -f -- "${__src}")"
# shellcheck disable=SC1091 # sourced file is followed only when shellcheck runs with -x
source "${__src%/*}/apprun-common.sh"

# brew owns updates for this AppImage; block the app's own update channel the
# same way the GitButler flatpak does. The flatpak compiles with the
# `disable-auto-updates` cargo feature, which pins the GUI's update-check
# interval to 0; the official .deb we repackage does not, but GitButler merges
# ~/.config/gitbutler/settings.json over its compiled defaults, so seeding the
# same key reproduces that behavior.
prevent_autoupdate() {
    local config_dir config_file tmp_file
    config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/gitbutler"
    config_file="${config_dir}/settings.json"
    [[ ! -L "${config_dir}" ]] || return 0
    [[ ! -L "${config_file}" ]] || return 0
    mkdir -p -- "${config_dir}" || return 0

    if [[ ! -s "${config_file}" ]]; then
        tmp_file="$(mktemp "${config_dir}/settings.json.tmp.XXXXXX")" || return 0
        printf '%s\n' '{"ui":{"checkForUpdatesIntervalInSeconds":0}}' > "${tmp_file}" || { rm -f -- "${tmp_file}"; return 0; }
        mv -- "${tmp_file}" "${config_file}" || { rm -f -- "${tmp_file}"; return 0; }
        return 0
    fi

    # Key already present with value 0: nothing to do. This is the steady
    # state after the first run, so the sed rewrite below (whole-file
    # rewrite + rename) is skipped on every launch.
    if grep -Eq '"checkForUpdatesIntervalInSeconds"[[:space:]]*:[[:space:]]*0([^0-9]|$)' "${config_file}" 2>/dev/null; then
        return 0
    fi

    # Key present with a non-zero value: force it to 0.
    if grep -q '"checkForUpdatesIntervalInSeconds"' "${config_file}" 2>/dev/null; then
        LC_ALL=C sed -i -E \
            's/"checkForUpdatesIntervalInSeconds"[[:space:]]*:[[:space:]]*[0-9]+/"checkForUpdatesIntervalInSeconds": 0/' \
            "${config_file}" 2>/dev/null || true
        return 0
    fi

    # Multi-line pretty-printed JSON (the app's own format): insert the key as
    # the first member of the "ui" object. BRE mode so "{" stays literal.
    if grep -q '^[[:space:]]*"ui"[[:space:]]*:[[:space:]]*{$' "${config_file}" 2>/dev/null; then
        LC_ALL=C sed -i '/^[[:space:]]*"ui"[[:space:]]*:[[:space:]]*{/a\    "checkForUpdatesIntervalInSeconds": 0,' \
            "${config_file}" 2>/dev/null || true
        return 0
    fi

    # No "ui" object at all: add one before the root's closing brace. The "$"
    # address marks the last line, so this works for both compact and
    # pretty-printed JSON. The bare "{}" case is handled first.
    if grep -qx '{[[:space:]]*}' "${config_file}" 2>/dev/null; then
        tmp_file="$(mktemp "${config_dir}/settings.json.tmp.XXXXXX")" || return 0
        printf '%s\n' '{"ui":{"checkForUpdatesIntervalInSeconds":0}}' > "${tmp_file}" || { rm -f -- "${tmp_file}"; return 0; }
        mv -- "${tmp_file}" "${config_file}" || { rm -f -- "${tmp_file}"; return 0; }
    else
        LC_ALL=C sed -i -E '$ s/\}[[:space:]]*$/,"ui":{"checkForUpdatesIntervalInSeconds":0}}/' \
            "${config_file}" 2>/dev/null || true
    fi
}

# Bundled webkit runtime libs and data live under usr/ inside the AppDir.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GIO_MODULE_DIR="${APPDIR}/usr/lib/gio/modules"
export GDK_PIXBUF_MODULE_FILE="${APPDIR}/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"

# WebKit helper paths are patched to be relative (././ prefix), so they
# only resolve when the AppDir root is the working directory.
cd "${APPDIR}"

# gitbutler-tauri picks CLI vs GUI from its argv[0] basename; the runtime
# re-execs AppRun with argv[0] changed, so restore the original via ARGV0.
prevent_autoupdate
exec -a "${ARGV0:-$0}" "${APPDIR}/opt/gitbutler/bin/gitbutler-tauri" "$@"
