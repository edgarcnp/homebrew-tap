# NOTE: Placeholders __PACKAGE_NAME__/__VERSION__ are substituted via render_template; injection mitigated by PACKAGE_NAME validation in build-appimage.sh
[Desktop Entry]
Name=__PACKAGE_DISPLAY_NAME__
Comment=__PACKAGE_COMMENT__
Exec=gitcomet
Icon=__PACKAGE_NAME__
Terminal=false
Type=Application
StartupWMClass=gitcomet
Categories=Development;RevisionControl;
X-AppImage-Version=__VERSION__
