{
  "name": "edgarcnp-homebrew-tap-packaging",
  "private": true,
  "type": "module",
  "description": "Build tooling for the AppImage casks in this tap. Bun runs the TypeScript directly; Zod schemas validate the app descriptors.",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "fbr": "bun packaging/bin/fbr.ts",
    "test": "bun test packaging/tests",
    "typecheck": "tsc --noEmit",
    "schema": "bun packaging/bin/fbr.ts descriptor-schema",
    "check:tools": "packaging/scripts/check-tools.sh",
    "lint:shell": "find packaging \\( -name '*.sh' -o -name '*.hook' \\) -print0 | xargs -0 shellcheck -x -P packaging",
    "style": "packaging/scripts/style.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
