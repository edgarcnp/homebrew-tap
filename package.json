{
  "name": "edgarcnp-homebrew-tap-packaging",
  "private": true,
  "type": "module",
  "description": "Build tooling for the AppImage casks in this tap. Bun runs the TypeScript directly; no build step, no runtime dependencies.",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "fbr": "bun packaging/bin/fbr.ts",
    "test": "bun test packaging/tests",
    "typecheck": "tsc --noEmit",
    "lint:shell": "find packaging -name '*.sh' -print0 | xargs -0 shellcheck",
    "style": "brew style edgarcnp/tap"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
