{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgarcnp.dev/schemas/manifest.schema.json",
  "title": "Build manifest",
  "description": "One manifest per built AppImage, written by `fbr build` next to the artifact and consumed by publish and cask render. Proposed in packaging/REDESIGN.md; not produced yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "app",
    "version",
    "architecture",
    "descriptor",
    "upstream",
    "artifact",
    "toolchain",
    "build"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "app": {
      "$ref": "#/$defs/safeIdentifier"
    },
    "version": {
      "$ref": "#/$defs/debVersion"
    },
    "architecture": {
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle",
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "oracle": {
          "enum": [
            "apt",
            "github-release",
            "electron-feed",
            "cdn-redirect",
            "update-manifest",
            "avakot"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "quick_sharun",
        "appimagetool",
        "bun"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "quick_sharun": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "appimagetool": {
          "type": "string",
          "minLength": 1
        },
        "bun": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "started_at",
        "finished_at",
        "smoke"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "started_at": {
          "$ref": "#/$defs/isoDate"
        },
        "finished_at": {
          "$ref": "#/$defs/isoDate"
        },
        "smoke": {
          "const": "passed"
        }
      }
    }
  },
  "$defs": {
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "debVersion": {
      "type": "string",
      "pattern": "^[0-9][0-9A-Za-z.+~_-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
