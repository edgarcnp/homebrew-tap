{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "abandonmentThreshold": "1 year",
  "addLabels": [
    "renovate",
    "dependencies"
  ],
  "automerge": false,
  "dependencyDashboard": false,
  "keepUpdatedLabel": "renovate-keep-updated",
  "lockFileMaintenance": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": true,
  "pruneBranchAfterAutomerge": true,
  "reviewers": [
    "edgarcnp"
  ],
  "rollbackPrs": true,
  "schedule": [
    "* * * * *"
  ],
  "vulnerabilityAlerts": {
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null,
    "rangeStrategy": "bump",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest"
  },
  "customManagers": [
    {
      "description": "actionlint release pinned by hand in the lint step of the test workflow",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/tests\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_VERSION=\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rhysd/actionlint",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "pkgforge appimagetool release pinned by hand in the AppImage build workflow",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-appimage\\.yml$/"
      ],
      "matchStrings": [
        "appimagetool/releases/download/(?<currentValue>\\d+\\.\\d+\\.\\d+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pkgforge-dev/appimagetool"
    },
    {
      "description": "quick-sharun and get-debloated-pkgs, pinned to a commit of Anylinux-AppImages",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packaging\\/scripts\\/install-anylinux-tools\\.sh$/"
      ],
      "matchStrings": [
        "PINNED_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "pkgforge-dev/Anylinux-AppImages",
      "packageNameTemplate": "https://github.com/pkgforge-dev/Anylinux-AppImages",
      "datasourceTemplate": "git-refs"
    },
    {
      "description": "brew container image nested in the tests workflow strategy matrix, which the github-actions manager cannot see (it only reads a job-level container:)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/tests\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/homebrew/brew:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "depNameTemplate": "ghcr.io/homebrew/brew",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "TypeScript stays on the 6.x line until this toolchain is ready for 7",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": ">=6.0.3 <7"
    },
    {
      "description": "@types/bun describes the Bun the CI runs, so it moves with the bun runtime rule, not ahead of it",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/bun"
      ],
      "allowedVersions": ">=1.4 <1.5"
    },
    {
      "description": "Actions are SHA-pinned; one PR per digest bump keeps the review small",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The tests workflow brew image is extracted by the regex customManager above; keep both brew digests in the GitHub Actions PR so the two files move together",
      "matchManagers": [
        "regex"
      ],
      "matchPackageNames": [
        "ghcr.io/homebrew/brew"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "The Bun pin gates engines, @types/bun and the toolchain runtime, so it is reviewed on its own",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "bun"
      ],
      "groupName": "bun runtime"
    },
    {
      "description": "Hand-pinned upstream tools whose version and local SHA-256 must move together",
      "matchPackageNames": [
        "rhysd/actionlint",
        "pkgforge-dev/appimagetool",
        "pkgforge-dev/Anylinux-AppImages"
      ],
      "groupName": "pinned upstream build tools",
      "prBodyNotes": [
        "Some dependencies in this group are verified against a SHA-256 pinned in this repository, which Renovate cannot recompute (actionlint's tarball and appimagetool's per-arch binaries). Update those pins in this PR: each check reports the hash it measured when the two disagree. pkgforge-dev/Anylinux-AppImages needs no such update: its tools are fetched from a URL addressed by the commit digest Renovate bumps."
      ]
    }
  ]
}
