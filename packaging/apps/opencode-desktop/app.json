{
  "id": "opencode-desktop",
  "appName": "OpenCode Desktop",
  "displayName": "OpenCode",
  "comment": "Open source AI coding agent",
  "cask": "opencode-desktop",
  "watch": {
    "feedUrl": "https://github.com/anomalyco/opencode/releases.atom",
    "versionPattern": "^v(\\d+\\.\\d+\\.\\d+(?:[.-]\\w+)*)$",
    "repo": "anomalyco/opencode"
  },
  "assetPrefix": "opencode-desktop",
  "tagPrefix": "opencode-desktop-v",
  "sourceRepo": "edgarcnp/homebrew-tap",
  "sourceOwner": "edgarcnp",
  "sourceDir": "packaging/apps/opencode-desktop",
  "buildCommand": "./build.sh",
  "debloatArgs": "--add-common --prefer-nano ffmpeg-mini",
  "needsWebkit": false,
  "architectures": ["amd64", "arm64"],
  "binaryTargets": ["opencode-desktop"],
  "oracle": {
    "kind": "update-manifest",
    "repository": "https://opencode.ai/update/api/latest/desktop/opencode",
    "packageName": "opencode-desktop",
    "assetTemplate": "opencode-desktop-linux-{arch}.deb",
    "downloadHosts": ["opencode.ai"]
  },
  "payload": {
    "kind": "deb-tree",
    "tree": "opt/OpenCode"
  },
  "icon": {
    "source": "usr/share/icons/hicolor/128x128/apps/ai.opencode.desktop.png",
    "size": "128x128"
  },
  "desktopTemplate": "templates/opencode-desktop.desktop",
  "updater": {
    "removeFeed": {
      "paths": ["bin/resources/app-update.yml"],
      "required": true
    },
    "env": {
      "OPENCODE_DISABLE_AUTOUPDATE": "1"
    },
    "residualScan": {
      "patterns": ["https://opencode.ai/update/api/"],
      "severity": "warning"
    }
  },
  "quickSharun": {
    "hooks": ["fix-namespaces.hook"],
    "env": {
      "OPTIMIZE_LAUNCH": "1"
    }
  }
}
