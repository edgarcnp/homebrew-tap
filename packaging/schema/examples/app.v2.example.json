{
  "$schema": "../app.schema.json",
  "schemaVersion": 2,
  "id": "vscode",
  "appName": "Visual Studio Code",
  "displayName": "Visual Studio Code",
  "comment": "Code Editing. Redefined.",
  "cask": "vscode",
  "watch": {
    "feedUrl": "https://github.com/microsoft/vscode/releases.atom",
    "format": "atom",
    "versionPattern": "^(\\d+\\.\\d+\\.\\d+(?:[.-]\\w+)*)$",
    "repo": "microsoft/vscode"
  },
  "assetPrefix": "vscode",
  "tagPrefix": "vscode-v",
  "releaseRepo": "edgarcnp/homebrew-tap",
  "debloatArgs": "--add-common --prefer-nano ffmpeg-mini",
  "architectures": ["amd64"],
  "binaryTargets": ["code"],
  "oracle": {
    "kind": "apt",
    "repository": "https://packages.microsoft.com/repos/code",
    "packageName": "code",
    "fingerprint": "BC528686B50D79E339D3721CEB3E94ADBE1229CF",
    "keyBase64Path": "packaging/apps/vscode/assets/microsoft-vscode-repository-key.gpg.base64"
  },
  "payload": {
    "kind": "deb-tree",
    "tree": "usr/share/code"
  },
  "icon": {
    "source": "usr/share/pixmaps/vscode.png",
    "size": "256x256"
  },
  "desktopTemplate": "templates/vscode.desktop",
  "updater": {
    "removeJsonKeys": {
      "file": "bin/resources/app/product.json",
      "keys": ["updateUrl", "checksums"]
    },
    "patchEndpoint": {
      "from": "update.code.visualstudio.com",
      "textReplacement": "update.invalid",
      "binaryReplacement": "update.invalidupdate.invalid",
      "targets": "all"
    },
    "residualScan": {
      "patterns": ["update.code.visualstudio.com"],
      "severity": "error"
    }
  },
  "quickSharun": {
    "hooks": ["fix-namespaces.hook"]
  },
  "homebrew": {
    "homepage": "https://code.visualstudio.com/",
    "desc": "Repackage of Visual Studio Code as an AppImage",
    "zap": [
      "~/.cache/Code",
      "~/.config/Code",
      "~/.vscode",
      "~/.vscode-cli",
      "~/.vscode-server"
    ],
    "conflicts": ["visual-studio-code", "vscodium"]
  }
}
