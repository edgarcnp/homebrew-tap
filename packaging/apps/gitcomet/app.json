{
  "id": "gitcomet",
  "appName": "GitComet",
  "displayName": "GitComet",
  "comment": "Fast, resource-efficient Git GUI written in Rust",
  "cask": "gitcomet",
  "watch": {
    "feedUrl": "https://api.github.com/repos/Auto-Explore/GitComet/releases/latest",
    "format": "github-release",
    "versionPattern": "^GitComet v(\\d+\\.\\d+\\.\\d+(?:[.-]\\w+)*)$",
    "repo": "Auto-Explore/GitComet"
  },
  "assetPrefix": "gitcomet",
  "tagPrefix": "gitcomet-v",
  "sourceRepo": "edgarcnp/homebrew-tap",
  "sourceOwner": "edgarcnp",
  "sourceDir": "packaging/apps/gitcomet",
  "buildCommand": "./build.sh",
  "debloatArgs": "--add-common",
  "architectures": ["amd64"],
  "binaryTargets": ["gitcomet"],
  "artifact": {
    "kind": "github-release",
    "repository": "https://api.github.com/repos/Auto-Explore/GitComet",
    "packageName": "gitcomet",
    "tagPrefix": "v",
    "assetNameTemplate": "gitcomet-v{version}-linux-x86_64.tar.gz"
  },
  "payload": {
    "kind": "tarball-tree",
    "target": "bin"
  },
  "icon": {
    "source": "templates/gitcomet.png",
    "size": "512x512",
    "base": "app"
  },
  "desktopTemplate": "templates/gitcomet.desktop",
  "updater": {
    "env": {
      "GITCOMET_NO_UPDATE_CHECK": "1"
    }
  },
  "quickSharun": {
    "hooks": ["fix-namespaces.hook"]
  },
  "waylandBackend": "auto"
}
