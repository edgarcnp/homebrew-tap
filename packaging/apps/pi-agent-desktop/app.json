{
  "id": "pi-agent-desktop",
  "appName": "Pi Agent Desktop",
  "displayName": "Pi Agent",
  "comment": "Desktop UI for the pi coding agent",
  "cask": "pi-agent-desktop",
  "watch": {
    "feedUrl": "https://api.github.com/repos/abcwyc/pi-agent-desktop/releases",
    "format": "github-release",
    "versionPattern": "^(?:pi-agent-desktop )?v(\\d+\\.\\d+\\.\\d+(?:[.-]\\w+)*)$",
    "repo": "abcwyc/pi-agent-desktop"
  },
  "assetPrefix": "pi-agent-desktop",
  "tagPrefix": "pi-agent-desktop-v",
  "sourceRepo": "edgarcnp/homebrew-tap",
  "sourceOwner": "edgarcnp",
  "sourceDir": "packaging/apps/pi-agent-desktop",
  "buildCommand": "./build.sh",
  "debloatArgs": "--add-common --prefer-nano webkit2gtk-4.1-mini gdk-pixbuf2-mini",
  "architectures": ["amd64"],
  "binaryTargets": ["pi-agent-desktop"],
  "artifact": {
    "kind": "github-release",
    "repository": "https://api.github.com/repos/abcwyc/pi-agent-desktop",
    "packageName": "pi-agent-desktop",
    "tagPrefix": "v",
    "assetNameTemplate": "Pi.Agent_{version}_amd64.deb"
  },
  "payload": {
    "kind": "deb-files",
    "files": ["usr/bin/pi-agent-desktop"],
    "trees": [
      {
        "source": "usr/lib/Pi Agent",
        "target": "lib/Pi Agent"
      }
    ]
  },
  "icon": {
    "source": "usr/share/icons/hicolor/128x128/apps/pi-agent-desktop.png",
    "size": "128x128"
  },
  "desktopTemplate": "templates/pi-agent-desktop.desktop",
  "updater": {
    "patchEndpoint": {
      "from": "https://github.com/abcwyc/pi-agent-desktop/releases/latest/download/latest.json",
      "textReplacement": "https://update.invalid/pi-agent-desktop/releases/latest/download/no/latest.json",
      "binaryReplacement": "https://update.invalid/pi-agent-desktop/releases/latest/download/no/latest.json",
      "targets": ["bin/pi-agent-desktop"]
    },
    "residualScan": {
      "patterns": ["https://github.com/abcwyc/pi-agent-desktop/releases/latest/download/latest.json"],
      "severity": "error"
    }
  },
  "quickSharun": {
    "hooks": ["fix-namespaces.hook"],
    "targets": ["lib/Pi Agent/resources/node/node"]
  }
}
