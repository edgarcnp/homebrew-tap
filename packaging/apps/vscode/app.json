{
  "id": "vscode",
  "appName": "Visual Studio Code",
  "displayName": "Visual Studio Code",
  "comment": "Code Editing. Redefined.",
  "cask": "vscode",
  "watch": {
    "feedUrl": "https://update.code.visualstudio.com/api/update/linux-x64/stable/latest",
    "format": "json",
    "versionField": "productVersion",
    "versionPattern": "^(\\d+\\.\\d+\\.\\d+)$",
    "repo": "microsoft/vscode"
  },
  "assetPrefix": "vscode",
  "tagPrefix": "vscode-v",
  "sourceRepo": "edgarcnp/homebrew-tap",
  "sourceOwner": "edgarcnp",
  "sourceDir": "packaging/apps/vscode",
  "buildCommand": "./build.sh",
  "debloatArgs": "--add-common --prefer-nano ffmpeg-mini gdk-pixbuf2-mini",
  "architectures": ["amd64"],
  "binaryTargets": ["code"],
  "artifact": {
    "kind": "json-asset",
    "url": "https://update.code.visualstudio.com/api/update/linux-x64/stable/latest",
    "downloadHosts": ["update.code.visualstudio.com", "vscode.download.prss.microsoft.com"],
    "urlField": "url",
    "sha256Field": "sha256hash",
    "versionField": "productVersion",
    "packageName": "code"
  },
  "payload": {
    "kind": "tarball-tree",
    "root": "VSCode-linux-x64",
    "target": "bin"
  },
  "icon": {
    "source": "resources/app/resources/linux/code.png",
    "size": "1024x1024"
  },
  "desktopTemplate": "templates/vscode.desktop",
  "updater": {
    "removeJsonKeys": {
      "file": "bin/resources/app/product.json",
      "keys": ["updateUrl", "checksums"]
    },
    "patchEndpoint": {
      "from": "update.code.visualstudio.com",
      "textReplacement": "update.invalid",
      "binaryReplacement": "update.invalidupdate.invalid",
      "targets": "all"
    },
    "residualScan": {
      "patterns": ["update.code.visualstudio.com"],
      "severity": "error"
    }
  },
  "quickSharun": {
    "hooks": ["fix-namespaces.hook"]
  }
}
